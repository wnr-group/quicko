# Copy this to .env:  cp .env.example .env
# These are EXPO_PUBLIC_ vars — bundled into the app, so NOT for secrets.

# false = use the real backend (quiko-app on :3000); true = in-app mock data.
EXPO_PUBLIC_MOCK=false

# Backend API base URL.
# IMPORTANT: use 127.0.0.1, NOT localhost — the iOS simulator resolves
# "localhost" to IPv6 (::1) where the dev server isn't listening.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
