{
  "expo": {
    "name": "Quiko",
    "slug": "quiko",
    "scheme": "quiko",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#fddc2b",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.quiko.mobile"
    },
    "android": {
      "package": "app.quiko.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#fddc2b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://127.0.0.1:3000"
    }
  }
}
