# Copy this to .env.local and fill in. NEVER commit .env.local.
#   cp .env.example .env.local

# ── Required ────────────────────────────────────────────────────
# Postgres. Matches docker-compose.yml (user/pass/db = "quiko", host port 5433).
DATABASE_URL=postgresql://quiko:quiko@127.0.0.1:5433/quiko

# Hard deadline (ms) for any single DB query. Guards against a serverless
# instance being handed a pooler connection whose server side has gone away:
# without it such a query never settles and the streamed page never finishes.
# Optional — defaults to 8000. Set 0 to disable.
# DB_QUERY_TIMEOUT_MS=8000

# Session-cookie signing secret. Generate one:  openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_openssl_rand_base64_32

# Dev OTP for mock SMS login — any phone number logs in with this code.
DEV_OTP=345678

# ── Optional providers — leave UNSET for local/demo mode ────────
# Payments (Cashfree Easy Split). Unset = simulated escrow, no real money.
# CASHFREE_ENV=sandbox
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_API_VERSION=2023-08-01
# APP_URL=http://localhost:3000

# SMS OTP (MSG91). Unset = mock: the code is always DEV_OTP.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Maps — Mapbox (GL JS map, Geocoding v6 search, Directions routes).
# PUBLIC token (pk.*) — shipped to the browser by design. In the Mapbox
# dashboard restrict it to your app URLs and public scopes only. Never put a
# secret (sk.*) token here. Unset = maps/search/route preview show an
# "unavailable" state; the app still works with manually-set coordinates.
NEXT_PUBLIC_MAPBOX_TOKEN=
# (NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN is accepted as an alias.)
# Optional custom style, e.g. mapbox://styles/<user>/<styleId>
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
