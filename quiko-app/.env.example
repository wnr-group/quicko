# Copy this to .env.local and fill in. NEVER commit .env.local.
#   cp .env.example .env.local

# ── Required ────────────────────────────────────────────────────
# Postgres. Matches docker-compose.yml (user/pass/db = "quiko", host port 5433).
DATABASE_URL=postgresql://quiko:quiko@127.0.0.1:5433/quiko

# Session-cookie signing secret. Generate one:  openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_openssl_rand_base64_32

# Dev OTP for mock SMS login — any phone number logs in with this code.
DEV_OTP=123456

# ── Optional providers — leave UNSET for local/demo mode ────────
# Payments (Cashfree Easy Split). Unset = simulated escrow, no real money.
# CASHFREE_ENV=sandbox
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_API_VERSION=2023-08-01
# APP_URL=http://localhost:3000

# SMS OTP (MSG91). Unset = mock: the code is always DEV_OTP.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Maps. Unset = free OpenStreetMap tiles + Nominatim geocoding (dev only).
# Set a MapTiler key to flip BOTH tiles and geocoding for production.
# NEXT_PUBLIC_MAPTILER_KEY=
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_ATTRIBUTION=
